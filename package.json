{
  "name": "robot-whisperer",
  "version": "0.1.0",
  "description": "A Postman-style desktop and web client for ROS",
  "author": {
    "name": "Mykhaylo Marfeychuk",
    "email": "Mika412@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite dev",
    "web": "bun run build:wasm:dev && RW_TARGET=web vite dev --port 5173",
    "web:release": "bun run build && bun run preview",
    "build": "bun run build:wasm && RW_TARGET=web vite build",
    "build:renderer": "vite build",
    "build:daemon": "cd core && cargo zigbuild --release -p rw-daemon --target x86_64-unknown-linux-gnu.2.28",
    "build:daemon:dev": "cd core && cargo build --release -p rw-daemon",
    "build:shell": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build:desktop": "bun run build:renderer && bun run build:daemon && bun run build:shell",
    "build:wasm": "wasm-pack build core/crates/rw-wasm --target web --release --out-dir ../../../src/lib/wasm/generated",
    "build:wasm:dev": "wasm-pack build core/crates/rw-wasm --target web --dev --out-dir ../../../src/lib/wasm/generated",
    "preview": "RW_TARGET=web vite preview",
    "start": "bun run build:desktop && electron .",
    "package": "bun run build:desktop && electron-builder --linux",
    "package:deb": "bun run build:desktop && electron-builder --linux deb",
    "package:appimage": "bun run build:desktop && electron-builder --linux AppImage",
    "package:snap": "bun run build:desktop && electron-builder --linux snap",
    "package:flatpak": "bun run build:desktop && electron-builder --linux flatpak",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "cd core && RW_INTEGRATION=1 cargo nextest run --workspace --run-ignored only",
    "prepare": "lefthook install"
  },
  "license": "MIT",
  "trustedDependencies": [
    "electron",
    "esbuild",
    "lefthook"
  ],
  "dependencies": {
    "@lucide/svelte": "^0.542.0",
    "tailwind-scrollbar": "^4.0.2",
    "three": "^0.184.0",
    "uplot": "^1.6.32",
    "urdf-loader": "^0.12.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/draco3dgltf": "^1.4.3",
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@xmldom/xmldom": "^0.9.10",
    "draco3dgltf": "^1.5.7",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-plugin-svelte": "^3.0.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "lefthook": "^1.10.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
